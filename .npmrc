# Проверять поле engines из package.json при установке.
# Без этого pnpm может пропустить несовместимую версию Node в зависимости
# от глобальных настроек участника — а ОС и окружения у всех разные.
engine-strict=true

# Настройка hoisting живёт в pnpm-workspace.yaml: ключ shamefully-hoist
# понимает только pnpm, и npm при каждом вызове ругался
# «Unknown project config» — лишний шум в выводе у всех участников.
