# Файлы, которые НЕ обновляются из шаблона.
#
# Важно: этот список действует только на синхронизацию. При создании
# репозитория из шаблона («Use this template») копируется всё дерево целиком —
# перечисленное здесь приезжает стартовыми заготовками и дальше принадлежит
# проекту. То есть «в ignore» означает «не трогать после создания»,
# а не «не копировать».

# Содержание презентаций
presentations/**
apps/**

# Данные проекта: название, автор, заголовок вкладки
shared/project.json

# Словарь предметной лексики (термины Slidev и сборки — в .cspell/infra.txt)
.cspell/project.txt

# Документация проекта. Инфраструктурная (AGENTS.md, docs/)
# синхронизируется — она про инструмент, а не про предмет
README.md
CLAUDE.md

# Настройки Claude Code: приезжают заготовкой, дальше автор меняет под себя.
# Общий skill (.claude/skills/) синхронизируется
.claude/settings.json

# Версии зависимостей проекта не должны откатываться к шаблонным.
# После обновления инфраструктуры выполните: pnpm install
pnpm-lock.yaml

# Workflow ссылается на путь шаблона — его нельзя затирать самим шаблоном
.github/workflows/template-sync.yml
