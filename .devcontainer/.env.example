# Devcontainer environment configuration
# Copy this file to .env and adjust as needed:
# cp .devcontainer/.env.example .devcontainer/.env

# Install Starship prompt
INSTALL_STARSHIP=false
# Install Node.js from .nvmrc
INSTALL_NODE=false
# Link host HOME for path compatibility
LINK_HOST_HOME=false
# Install Claude Code CLI
INSTALL_CLAUDE=false
# Install terminal tools (eza, fzf, bat, zsh-autosuggestions)
INSTALL_TERMINAL_TOOLS=false
# Install Playwright Chromium for PDF export (pnpm export)
INSTALL_PLAYWRIGHT_BROWSER=false
